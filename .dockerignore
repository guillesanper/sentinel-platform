# ============================================================================
# Docker Ignore File - Sentinel Platform
# ============================================================================
# Excludes files/folders from Docker build context for faster builds
# and smaller images.
# ============================================================================

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/
env/

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Documentation
docs/_build/
site/

# Terraform
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Kubernetes secrets
k8s/**/*secret*.yaml
k8s/**/*secrets*.yaml

# Local development
.env
.env.*
!.env.example
*.local

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Models (will be mounted or downloaded)
models/*.joblib
models/*.pkl
models/*.h5

# MLflow
mlruns/
mlartifacts/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Test artifacts
tests/fixtures/
tests/output/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Documentation
*.md
!README.md
LICENSE
CHANGELOG.md
CONTRIBUTING.md

# Development files
Makefile
docker-compose*.yml
*.Dockerfile
!api/Dockerfile
